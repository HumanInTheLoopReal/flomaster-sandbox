{
  "agent_profile_id": "agent_profile_implement_coder",
  "version": "1",
  "agent_id": {
    "value": "agent_implement_coder"
  },
  "name": "Implement Coder",
  "responsibility": "Make one Work Item's change in the Workspace and record what changed.",
  "profile": {
    "profile_id": "implement_coder",
    "version": "1",
    "runtime_id": "claude_agent_sdk",
    "allowed_model_ids": [
      "claude-haiku-5-5"
    ],
    "preferred_model_id": "claude-haiku-5-5",
    "max_turns": 8,
    "max_output_tokens": 8192,
    "max_cost_usd": 2.0
  },
  "prompt": {
    "definition_id": "implement_prompt",
    "version": "1"
  },
  "operation_grants": [],
  "sdk_tool_ids": [
    "read_workspace",
    "search_workspace",
    "write_workspace"
  ],
  "skill_ids": [],
  "result_schema": {
    "content_digest": "sha256:implement-change-envelope",
    "contract": {
      "schema_name": "ImplementChange",
      "json_schema": {
        "type": "object",
        "properties": {
          "change_summary": {
            "type": "string",
            "maxLength": 400
          },
          "commit_subject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100000,
            "pattern": "\\S"
          },
          "changed_paths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          }
        },
        "required": [
          "change_summary",
          "commit_subject",
          "changed_paths"
        ],
        "additionalProperties": false
      }
    }
  }
}
