{
  "agent_profile_id": "agent_profile_close_reporter",
  "version": "1",
  "agent_id": {
    "value": "agent_close_reporter"
  },
  "name": "Close Reporter",
  "responsibility": "Say what closed one Work Item and which state it closes in.",
  "profile": {
    "profile_id": "close_reporter",
    "version": "1",
    "runtime_id": "claude_agent_sdk",
    "allowed_model_ids": [
      "claude-haiku-5-5"
    ],
    "preferred_model_id": "claude-haiku-5-5",
    "max_turns": 4,
    "max_output_tokens": 2048,
    "max_cost_usd": 1.0
  },
  "prompt": {
    "definition_id": "close_note_prompt",
    "version": "1"
  },
  "result_schema": {
    "content_digest": "sha256:close-report-envelope",
    "contract": {
      "schema_name": "CloseReport",
      "json_schema": {
        "type": "object",
        "properties": {
          "state": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S"
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100000
          }
        },
        "required": [
          "state",
          "note"
        ],
        "additionalProperties": false
      }
    }
  }
}
