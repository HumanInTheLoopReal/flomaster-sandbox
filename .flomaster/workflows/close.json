                    "maxLength": 1000,
                    "minLength": 1,
                    "title": "Title",
                    "type": "string"
                  },
                  "body": {
                    "default": "",
                    "maxLength": 100000,
                    "title": "Body",
                    "type": "string"
                  },
                  "state": {
                    "maxLength": 200,
                    "minLength": 1,
                    "title": "State",
                    "type": "string"
                  },
                  "labels": {
                    "default": [],
                    "items": {
                      "type": "string"
                    },
                    "title": "Labels",
                    "type": "array"
                  },
                  "repository_reference": {
                    "anyOf": [
                      {
                        "maxLength": 1000,
                        "minLength": 1,
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
