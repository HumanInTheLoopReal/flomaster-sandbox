                    "default": null,
                    "title": "Repository Reference"
                  },
                  "provider_revision": {
                    "maxLength": 500,
                    "minLength": 1,
                    "title": "Provider Revision",
                    "type": "string"
                  },
                  "assignees": {
                    "default": [],
