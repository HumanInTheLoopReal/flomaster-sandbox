                      "value": {
                        "maxLength": 200,
                        "minLength": 3,
                        "title": "Value",
                        "type": "string"
                      }
                    },
                    "required": [
                      "value"
                    ],
                    "title": "WorkItemId",
                    "type": "object"
                  },
                  "WorkItemReference": {
                    "additionalProperties": false,
                    "description": "Identify one provider object without embedding provider SDK data or credentials.\n\nThis is a domain value observed by intake and writeback ports. Its provider name and\nexternal key are stable correlation facts; it does not prove that the remote item\ncurrently exists or that the URL was fetched.",
