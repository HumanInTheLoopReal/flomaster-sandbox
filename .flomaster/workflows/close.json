                      {
                        "$ref": "#/$defs/WorkItemReference"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null
                  },
                  "blocked_by": {
                    "default": [],
                    "items": {
                      "$ref": "#/$defs/WorkItemReference"
                    },
                    "title": "Blocked By",
                    "type": "array"
                  },
                  "blocking": {
                    "default": [],
                    "items": {
                      "$ref": "#/$defs/WorkItemReference"
                    },
                    "title": "Blocking",
                    "type": "array"
                  },
                  "priority": {
                    "anyOf": [
                      {
                        "maxLength": 100,
                        "minLength": 1,
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "title": "Priority"
                  },
                  "timebox": {
                    "anyOf": [
                      {
                        "maxLength": 200,
                        "minLength": 1,
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "title": "Timebox"
                  },
                  "project": {
                    "anyOf": [
                      {
                        "maxLength": 500,
                        "minLength": 1,
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "title": "Project"
                  },
                  "estimate_points": {
                    "anyOf": [
                      {
                        "maximum": 8,
                        "minimum": 0,
                        "type": "integer"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "title": "Estimate Points"
                  },
                  "updated_at": {
                    "format": "date-time",
