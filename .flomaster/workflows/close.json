{
  "workflow_definition_id": {
    "value": "workflow_close"
  },
  "version": "1",
  "name": "Close",
  "description": "Walk the admitted Work Item from merged to its closing state and say on the ticket what closed it.",
  "visibility": "public",
  "steps": [
    {
      "step_definition_id": "record_merge",
      "name": "Record that the change merged",
      "description": "Move the admitted Work Item to the state that says its change is in, so the closing note is written from a ticket that already carries that fact.",
      "inputs": [
        {
          "input_name": "id",
          "value": {
            "kind": "work_item",
            "field": "reference",
            "data_schema": {
              "content_digest": "sha256:8964c31cef243ee9c4419f51e52a90efb43965f49dd8971905df8f1a955ddf0b",
              "contract": {
                "schema_name": "WorkItemReference",
                "json_schema": {
                  "type": "object",
                  "properties": {
                    "provider_name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "external_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    },
                    "url": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 4096
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "provider_name",
                    "external_id"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        },
        {
          "input_name": "state",
          "value": {
            "kind": "literal",
            "value": "merged",
            "data_schema": {
              "content_digest": "sha256:969a792f7c16f5a0b1ccf42ee44b1d10198478572371666d4307e6437dff4f5a",
              "contract": {
                "schema_name": "TrackerState",
                "json_schema": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "\\S"
                }
              }
            }
          }
        },
        {
          "input_name": "reason",
          "value": {
            "kind": "literal",
            "value": "The change for this Work Item merged into the target branch.",
            "data_schema": {
              "content_digest": "sha256:574bb972a9043f5f048277cca137332e61039b7390202bead2c22ca483701cca",
              "contract": {
                "schema_name": "TrackerTransitionReason",
                "json_schema": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100000
                }
              }
            }
          }
        }
      ],
      "outputs": [
        {
          "kind": "value",
          "output_name": "work_item",
