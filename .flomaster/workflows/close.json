                      "provider_name": {
                        "maxLength": 100,
                        "minLength": 1,
                        "title": "Provider Name",
                        "type": "string"
                      },
                      "external_id": {
                        "maxLength": 500,
                        "minLength": 1,
                        "title": "External Id",
                        "type": "string"
                      },
                      "url": {
                        "anyOf": [
                          {
                            "maxLength": 4096,
                            "minLength": 1,
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "default": null,
                        "title": "Url"
                      }
                    },
                    "required": [
                      "provider_name",
                      "external_id"
                    ],
                    "title": "WorkItemReference",
                    "type": "object"
                  }
                },
                "additionalProperties": false,
                "description": "Capture the latest normalized provider facts relevant to workflow intake.\n\nA source adapter replaces this immutable snapshot after loading it. The model owns\nno routing decision, provider status mapping, or claim side effect. Application\nservices decide whether an item is claimable from the explicit revision, assignment,\nplanning, and relationship facts below; adapters do not hide that policy in a\nprovider-specific claim convention.",
