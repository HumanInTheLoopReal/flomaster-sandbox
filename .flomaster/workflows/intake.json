{
  "workflow_definition_id": {
    "value": "workflow_intake"
  },
  "version": "1",
  "name": "Intake",
  "description": "Read one Work Item, decide what kind of work it asks for, and record that decision.",
  "visibility": "public",
  "outputs": [
    {
      "output_name": "classification_record",
      "description": "The kind of work the Work Item asks for beside the restated request, for a parent Workflow to route on. It is named apart from the Step output it is sourced from so a caller that confuses the two names cannot bind either by accident.",
      "source": {
        "kind": "upstream_output",
        "step_definition_id": "record_intake",
        "output_name": "classification",
        "data_schema": {
          "content_digest": "sha256:intake-classification-record",
          "contract": {
            "schema_name": "IntakeClassificationRecord",
            "json_schema": {
              "type": "object",
              "properties": {
                "work_kind": {
                  "type": "string",
                  "enum": [
                    "bug",
                    "feature",
                    "chore"
                  ]
                },
                "request": {
                  "type": "string",
                  "maxLength": 400
                }
              },
              "required": [
                "work_kind",
                "request"
              ],
              "additionalProperties": false
            }
          }
        }
      },
      "required": true
    }
  ],
  "steps": [
    {
      "kind": "agent",
      "step_definition_id": "classify",
      "name": "Classify the request",
      "description": "Name the kind of work the Work Item asks for and restate its request once.",
      "agent": {
        "agent_profile_id": "agent_profile_intake_classifier",
        "version": "1"
      },
      "runtime": {
        "runtime_id": "claude_agent_sdk",
        "sdk_tool_ids": [],
        "skill_ids": [],
        "budget": {
          "max_turns": 8,
          "max_cost_usd": 0.5
        },
        "context_token_budget": 4000
      },
      "granted_operations": [],
      "outputs": [
        {
          "kind": "value",
          "output_name": "work_kind",
          "data_schema": {
            "content_digest": "sha256:intake-work-kind",
            "contract": {
              "schema_name": "IntakeWorkKind",
              "json_schema": {
                "type": "string",
                "enum": [
                  "bug",
                  "feature",
                  "chore",
                  "needs_clarification"
                ]
              }
            }
          },
          "required": true
        },
        {
          "kind": "value",
          "output_name": "request",
          "data_schema": {
            "content_digest": "sha256:intake-request-restatement",
            "contract": {
              "schema_name": "IntakeRequest",
              "json_schema": {
                "type": "string",
                "maxLength": 400
              }
            }
          },
          "required": true
        }
      ]
    },
    {
      "kind": "script",
      "step_definition_id": "require_clear_classification",
      "name": "Require a clear classification",
      "description": "Stop the Run when the classifier could not decide from the text, saying so in words a person can act on, so no later Step reads a placeholder kind.",
      "dependencies": [
        {
          "step_definition_id": "classify",
          "mode": "required"
        }
      ],
      "executable": ".flomaster/scripts/require_clear_classification.sh",
      "runtime": "posix_shell",
      "arguments": [],
      "inputs": [
        {
          "input_name": "work_kind",
          "value": {
            "kind": "upstream_output",
            "step_definition_id": "classify",
            "output_name": "work_kind",
            "data_schema": {
              "content_digest": "sha256:intake-work-kind",
              "contract": {
                "schema_name": "IntakeWorkKind",
                "json_schema": {
                  "type": "string",
                  "enum": [
                    "bug",
                    "feature",
                    "chore",
                    "needs_clarification"
                  ]
                }
              }
            }
          }
        }
      ],
      "failure_policy": {
        "behavior": "halt"
      }
    },
    {
      "kind": "script",
      "step_definition_id": "record_intake",
      "name": "Record the intake decision",
      "description": "Write what classify retained into the intake record and export it for a parent Workflow. The record path is declared once as the argument the script writes to, and the intake_record output captures that same path.",
      "dependencies": [
        {
          "step_definition_id": "classify",
          "mode": "required"
        },
        {
          "step_definition_id": "require_clear_classification",
          "mode": "required"
        }
      ],
      "executable": ".flomaster/scripts/record_intake.sh",
      "runtime": "posix_shell",
      "arguments": [
        {
          "kind": "format",
          "segments": [
            {
              "kind": "literal",
              "text": "artifacts/intake.json"
            }
          ],
          "data_schema": {
            "content_digest": "sha256:intake-record-path",
            "contract": {
              "schema_name": "IntakeRecordPath",
              "json_schema": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            }
          }
        }
      ],
      "inputs": [
        {
          "input_name": "work_kind",
          "value": {
            "kind": "upstream_output",
            "step_definition_id": "classify",
            "output_name": "work_kind",
            "data_schema": {
              "content_digest": "sha256:intake-work-kind",
              "contract": {
                "schema_name": "IntakeWorkKind",
                "json_schema": {
                  "type": "string",
                  "enum": [
                    "bug",
                    "feature",
                    "chore",
                    "needs_clarification"
                  ]
                }
              }
            }
          }
        },
        {
          "input_name": "request",
          "value": {
            "kind": "upstream_output",
            "step_definition_id": "classify",
            "output_name": "request",
            "data_schema": {
              "content_digest": "sha256:intake-request-restatement",
              "contract": {
                "schema_name": "IntakeRequest",
                "json_schema": {
                  "type": "string",
                  "maxLength": 400
                }
              }
            }
          }
        }
      ],
      "outputs": [
        {
          "kind": "value",
          "output_name": "classification",
          "data_schema": {
            "content_digest": "sha256:intake-classification-record",
            "contract": {
              "schema_name": "IntakeClassificationRecord",
              "json_schema": {
                "type": "object",
                "properties": {
                  "work_kind": {
                    "type": "string",
                    "enum": [
                      "bug",
                      "feature",
                      "chore"
                    ]
                  },
                  "request": {
                    "type": "string",
                    "maxLength": 400
                  }
                },
                "required": [
                  "work_kind",
                  "request"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": true
        },
        {
          "kind": "file",
          "output_name": "intake_record",
          "path": {
            "kind": "format",
            "segments": [
              {
                "kind": "literal",
                "text": "artifacts/intake.json"
              }
            ],
            "data_schema": {
              "content_digest": "sha256:intake-record-path",
              "contract": {
                "schema_name": "IntakeRecordPath",
                "json_schema": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                }
              }
            }
          },
          "artifact_kind": "change_request",
          "required": true,
          "max_bytes": 4096
        }
      ]
    }
  ]
}
